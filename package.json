{
  "name": "dsh-plugin-whale-notify",
  "version": "0.2.1",
  "description": "任务(turn)结束时推一条 🐋 通知。DSH-Android 专用：vivo V2617A / Android 16 实测通过，其他品牌未测。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-notification.jpg",
    "test",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "notification"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WYHWTF/dsh-plugin-whale-notify.git"
  },
  "homepage": "https://github.com/WYHWTF/dsh-plugin-whale-notify#readme",
  "author": "WYHWTF"
}
